{
  // 기본 코드 포매터로 Prettier 확장을 지정
  "editor.defaultFormatter": "esbenp.prettier-vscode",

  // 파일 저장 시 기본 포매터(Prettier)를 사용한 자동 서식 정리 활성화
  "editor.formatOnSave": true,

  // 파일 저장 시 실행할 코드 액션 설정
  "editor.codeActionsOnSave": {
    // 명시적인 수동 저장(Cmd+S / Ctrl+S) 시에만 ESLint 자동 수정을 실행하도록 설정
    // 타이핑 도중의 자동 저장(afterDelay 등) 시 상시 실행되는 것이 아니며, 불필요한 상시 자동 수정을 방지합니다.
    "source.fixAll.eslint": "explicit"
  }
}
